# Production settings for deploy/compose/docker-compose.prod.yml.
# Copy to deploy/compose/.env.prod (ignored by git) and fill in.

# ─── Names ───────────────────────────────────────────────────
# Both must resolve to this machine; ports 80 and 443 must be reachable.
APP_DOMAIN=app.example.com
COORDINATOR_DOMAIN=coordinator.example.com
ACME_EMAIL=ops@example.com          # Let's Encrypt expiry notices

# ─── Secrets ─────────────────────────────────────────────────
# openssl rand -hex 32   (each one different)
JWT_SECRET=
INTERNAL_SERVICE_SECRET=
POSTGRES_PASSWORD=
# openssl rand -base64 32   Hosts pin this key at enrolment: changing it later
# makes every enrolled host refuse jobs until it re-enrols. Back it up.
MANIFEST_SIGNING_KEY=

# ─── Operations ──────────────────────────────────────────────
PLATFORM_ADMIN_EMAILS=              # comma-separated; these accounts see the operations console
# SIGNUP_CREDIT=500 INR
# HOST_PROBATION_DAYS=7
# INFERENCE_HOST=                   # e.g. inference.example.com; needs its own Caddy site

# ─── Email (password reset) ──────────────────────────────────
# Without SMTP, password reset emails cannot be sent in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_FROM=no-reply@app.example.com

# ─── Payments (Razorpay) ─────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Image tag to build and run.
# TAG=latest

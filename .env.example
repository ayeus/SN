# Copy to .env to override development defaults (scripts/dev.sh loads it).
# Every service has working dev defaults; production refuses to start without
# real values for the secrets below.

SN_ENV=dev

# Secrets (production: long random values, identical across services)
# JWT_SECRET=
# INTERNAL_SERVICE_SECRET=
# MANIFEST_SIGNING_KEY=          # base64 32-byte Ed25519 seed; dev derives one

# Data
# DATABASE_URL=postgres://ayeusann:ayeusann_dev@localhost:5433/ayeusann_dev?sslmode=disable
# REDIS_URL=redis://localhost:6379

# Public addresses shown to customers and hosts. In development leave these
# unset: install commands and endpoints then use this machine's address on the
# local network (docs/connect-a-gpu.md). Set them to pin an address.
# PUBLIC_URL=http://192.168.1.10:8080
# Agents connect to PUBLIC_URL too (the gateway forwards their sessions). Set
# this only to give agents a separate address, e.g. the coordinator's own port.
# COORDINATOR_PUBLIC_URL=http://192.168.1.10:50051
# Every address agents may use, newest first. Connected agents learn the list
# and move by themselves when an address is retired (docs/connect-a-gpu.md).
# COORDINATOR_URLS=http://new.example.net:8080,http://192.168.1.10:8080
# Where the gateway reaches the coordinator's agent port, and where it serves
# its own metrics (never on the public port).
# COORDINATOR_GRPC_URL=http://localhost:50051
# METRICS_ADDR=127.0.0.1:9080

# Public half of the key that signs agent releases (cmd/release-sign). With
# it set, the coordinator offers the release published in DOWNLOADS_DIR to
# agents that are behind. The private half is never given to a service.
# RELEASE_PUBLIC_KEY=

# Outside development, hosts reporting a simulated GPU are refused. The
# end-to-end tests of a private or production stack turn this on.
# ALLOW_FAKE_GPU=false
# Connection pool per service (defaults: 25 and 5).
# DB_MAX_CONNS=25
# DB_MIN_CONNS=5
# INFERENCE_HOST=                # e.g. inference.example.com → {deployment}.inference.example.com

# Who may create an account: open (the development default), invite or closed.
# Outside development the default is invite: accounts come from invitation
# links created in the operations console.
# SIGNUP_MODE=open
# The account that signs up with this code becomes the operator. Set by
# `make private-init` on a private installation.
# OWNER_CODE=

# Operations console access in development (comma-separated emails). Ignored
# outside development, where the operator is the account made with OWNER_CODE.
# PLATFORM_ADMIN_EMAILS=you@example.com

# Hosts
# HOST_PROBATION_DAYS=7          # dev script sets 0

# Production: deploy/compose/.env.prod.example covers the Docker Compose stack.
# Running the binaries yourself, give each service TLS:
# TLS_CERT_FILE= / TLS_KEY_FILE= or SN_TLS_TERMINATED_BY_PROXY=true
# GRPC_TLS_CERT_FILE= / GRPC_TLS_KEY_FILE=
# TRUST_PROXY_HEADERS=true      # only behind a proxy that sets X-Forwarded-For

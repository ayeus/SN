# SpazeNode Development Environment Variables
# Copy to .env and customize as needed.

SN_ENV=dev

# Database
DATABASE_URL=postgres://spazenode:spazenode_dev@localhost:5433/spazenode?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# NATS
NATS_URL=nats://localhost:4222

# MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=spazenode
S3_SECRET_KEY=spazenode_dev
S3_BUCKET=spazenode-models

# Service Ports
GATEWAY_PORT=8080
CONTROL_API_PORT=8081
SCHEDULER_PORT=8082
COORDINATOR_PORT=8083
ROUTER_PORT=8084
INFERENCE_GW_PORT=8085
BILLING_PORT=8086
TRUST_PORT=8087

# Agent (Rust)
SN_COORDINATOR_URL=http://localhost:8083
SN_FAKE_GPU=true
SN_HEARTBEAT_INTERVAL=5

# JWT (will be generated properly in Phase 2)
JWT_SECRET=dev-secret-do-not-use-in-production
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Razorpay (use test keys in development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
